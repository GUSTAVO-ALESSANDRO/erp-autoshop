PORT=3000

# Configurações do PostgreSQL (Docker local ou Supabase)
# DB_HOST=host.docker.internal
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=autocare_db
DB_SSL=false

#Segredos de authenticação
